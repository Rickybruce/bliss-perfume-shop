diff --git a/public/css/base.css b/public/css/base.css
index e69de29..35f9cd9 100644
--- a/public/css/base.css
+++ b/public/css/base.css
@@ -0,0 +1,91 @@
+/* Shared styles for the plain content pages (delivery, contact, privacy,
+   404) and the site footer. Load AFTER shop.css, which defines the
+   variables, body and site header. */
+
+.page-main {
+  max-width: 680px;
+  margin: 0 auto;
+  padding: 32px 20px 64px;
+}
+
+.page-main h1 {
+  margin: 0 0 8px;
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: 1.7rem;
+  font-weight: 400;
+}
+
+.page-main h2 {
+  margin: 28px 0 8px;
+  font-size: 1.05rem;
+}
+
+.page-main p,
+.page-main li {
+  color: var(--muted);
+}
+
+.page-main ul {
+  padding-left: 20px;
+}
+
+.page-main a {
+  color: var(--text);
+}
+
+.page-lede {
+  margin: 0 0 8px;
+}
+
+.fee-table {
+  width: 100%;
+  border-collapse: collapse;
+  margin: 12px 0;
+}
+
+.fee-table th,
+.fee-table td {
+  padding: 10px 12px;
+  border-bottom: 1px solid var(--border);
+  text-align: left;
+  font-size: 0.92rem;
+}
+
+.fee-table th {
+  color: var(--text);
+  font-weight: 600;
+}
+
+.fee-table td {
+  color: var(--muted);
+}
+
+.page-btn {
+  display: inline-block;
+  margin-top: 20px;
+  padding: 11px 20px;
+  background: var(--text);
+  color: var(--bg) !important;
+  border-radius: var(--radius);
+  font-weight: 600;
+  text-decoration: none;
+}
+
+.site-footer {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px 20px;
+  justify-content: center;
+  padding: 24px 20px;
+  border-top: 1px solid var(--border);
+  font-size: 0.85rem;
+}
+
+.site-footer a {
+  color: var(--muted);
+  text-decoration: none;
+}
+
+.site-footer a:hover {
+  color: var(--text);
+}
diff --git a/public/css/cart.css b/public/css/cart.css
index e69de29..651dfd6 100644
--- a/public/css/cart.css
+++ b/public/css/cart.css
@@ -0,0 +1,217 @@
+/* Cart page. Loaded after shop.css, which supplies the variables, body and
+   site header. Dark, minimal, mobile-first. */
+
+.cart-main {
+  max-width: 960px;
+  margin: 0 auto;
+  padding: 28px 20px 60px;
+}
+
+.cart-main h1 {
+  margin: 0 0 24px;
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: 1.7rem;
+  font-weight: 400;
+}
+
+.cart-empty-text {
+  color: var(--muted);
+  margin: 0 0 20px;
+}
+
+.cart-layout {
+  display: grid;
+  gap: 24px;
+  align-items: start;
+}
+
+@media (min-width: 800px) {
+  .cart-layout {
+    grid-template-columns: 1fr 300px;
+  }
+}
+
+/* ── Line items ───────────────────────────────────────────────────── */
+.cart-items {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+.cart-item {
+  display: grid;
+  grid-template-columns: 72px 1fr;
+  gap: 14px;
+  padding: 14px;
+  background: var(--field);
+  border: 1px solid var(--card-border, #2a2a2a);
+  border-radius: var(--radius);
+}
+
+.item-thumb,
+.item-thumb-placeholder {
+  width: 72px;
+  height: 72px;
+  border-radius: 4px;
+  object-fit: cover;
+  background: #222;
+}
+
+.item-thumb-placeholder {
+  display: flex;
+  align-items: center;
+  justify-content: center;
